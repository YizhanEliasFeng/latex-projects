\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{ Experimental work suggests that exposure to out-group-targeting memes does not so much persuade people to change sides as it entrenches existing identities, increasing polarization especially among strong partisans \blx@tocontentsinit {0}\parencite {galipeau2023impactpoliticalmemes}.}}{4}{section*.32}%
\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{ They solidify pre-existing identities, rather than flipping loyalties.}}{4}{section*.33}%
